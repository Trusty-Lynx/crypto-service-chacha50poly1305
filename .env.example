# copy this to .env, never commit real values

# token the vault service has to send us in X-Service-Token
VAULT_SERVICE_TOKEN=

# our token for calling the key service
CHACHA_SERVICE_TOKEN=

# base url of the key service, e.g. http://key-service:8080
# can only stay empty in development mode, every user gets the same test key then
KEY_SERVICE_URL=
